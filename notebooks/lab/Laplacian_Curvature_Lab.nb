714, 0.121608, 0.087613, -0.04762, 0.035714, 0, 0.035714, -0.04762, 0.087613, 0.121608, 0.035714, 0.121608, 0.087613, 0.333333, 0.087613, -0.04762, 0.087613, 0.333333}, \"forman\" -> {-1, -1, -2, -3, -2, -3, -1, -3, -1, -3, -2, -4, -4, -4, -4, -3, -4, -2, -3, -2, -4, -4, -4, -4, -3, -4, -2, -3, -1, -4, -3, -4, -3, -3, -3, -1, -1, -2, -2, -1}, \"formanAug\" -> {-1, -1, -2, -3, -2, -3, -1, -3, -1, -3, -2, -4, -4, -4, -4, -3, -4, -2, -3, -2, -4, -4, -4, -4, -3, -4, -2, -3, -1, -4, -3, -4, -3, -3, -3, -1, -1, -2, -2, -1}, \"res\" -> {0.301060606061, 0.0380303030303, 0.0627272727273, 0.0380303030303, 0.301060606061, 0.0380303030303, -0.101515151515, -0.0760606060606, -0.101515151515, 0.0380303030303, 0.0627272727273, -0.0760606060606, -0.0490909090909, -0.0760606060606, 0.0627272727273, 0.0380303030303, -0.101515151515, -0.0760606060606, -0.101515151515, 0.0380303030303, 0.301060606061, 0.0380303030303, 0.0627272727273, 0.0380303030303, 0.301060606061}, \"stein\" -> {1, 0.375, 0.375, 0.375, 1, 0.375, -0.25, -0.25, -0.25, 0.375, 0.375, -0.25, -0.25, -0.25, 0.375, 0.375, -0.25, -0.25, -0.25, 0.375, 1, 0.375, 0.375, 0.375, 1}|>, \"dumbbell\" -> <|\"n\" -> 12, \"edges\" -> {{1, 2}, {8, 9}, {1, 3}, {8, 10}, {1, 4}, {8, 11}, {1, 5}, {8, 12}, {2, 3}, {9, 10}, {2, 4}, {9, 11}, {2, 5}, {9, 12}, {3, 4}, {10, 11}, {3, 5}, {10, 12}, {4, 5}, {11, 12}, {5, 6}, {6, 7}, {7, 8}}, \"lambda1\" -> 0.0286185595244, \"lambdaMax\" -> 1.68374064344, \"lly\" -> {1.25, 0.85, 1.25, 0.85, 1.25, 0.85, 0.85, 0.85, 1.25, 1.25, 1.25, 1.25, 0.85, 1.25, 1.25, 1.25, 0.85, 1.25, 0.85, 1.25, -0.6, 0, -0.6}, \"k0\" -> {0.75, 0.6, 0.75, 0.6, 0.75, 0.6, 0.6, 0.6, 0.75, 0.75, 0.75, 0.75, 0.6, 0.75, 0.75, 0.75, 0.6, 0.75, 0.6, 0.75, -0.6, 0, -0.6}, \"be\" -> {0.810496, 0.810496, 0.810496, 0.810496, -0.027695, -0.383096, -0.383096, -0.027695, 0.810496, 0.810496, 0.810496, 0.810496}, \"forman\" -> {-4, -5, -4, -5, -4, -5, -5, -5, -4, -4, -4, -4, -5, -4, -4, -4, -5, -4, -5, -4, -3, 0, -3}, \"formanAug\" -> {5, 4, 5, 4, 5, 4, 4, 4, 5, 5, 5, 5, 4, 5, 5, 5, 4, 5, 4, 5, -3, 0, -3}, \"res\" -> {0.2, 0.2, 0.2, 0.2, -0.3, -6.66133814775*^-16, -1.33226762955*^-15, -0.3, 0.2, 0.2, 0.2, 0.2}, \"stein\" -> {0.774193548387, 0.774193548387, 0.774193548387, 0.774193548387, -1.16129032258, 4.60742555219*^-15, -6.60582699652*^-15, -1.16129032258, 0.774193548387, 0.774193548387, 0.774193548387, 0.774193548387}|>|>, \"flows\" -> <|\"wiggle\" -> <|\"A0\" -> 3.39343363459, \"t\" -> 0.498, \"A\" -> 0.255225351169, \"rate\" -> -6.30162305908, \"vertices\" -> 36|>, \"star\" -> <|\"A0\" -> 3.45267940093, \"t\" -> 0.504, \"A\" -> 0.271862433851, \"rate\" -> -6.31114477595, \"vertices\" -> 31|>, \"bean\" -> <|\"A0\" -> 3.43379755367, \"t\" -> 0.504, \"A\" -> 0.260886381609, \"rate\" -> -6.29545867472, \"vertices\" -> 39|>, \"ellipse\" -> <|\"A0\" -> 3.14049769671, \"t\" -> 0.462, \"A\" -> 0.234885799578, \"rate\" -> -6.28920324055, \"vertices\" -> 47|>|>, \"ollivier\" -> {<|\"K\" -> -2, \"at005\" -> -0.250151370483, \"emax\" -> 0.999648661086, \"atmax\" -> -0.314776689329|>, <|\"K\" -> -1, \"at005\" -> -0.125036620424, \"emax\" -> 1.2, \"atmax\" -> -0.14806796806|>, <|\"K\" -> 0, \"at005\" -> 0, \"emax\" -> 1.2, \"atmax\" -> 0|>, <|\"K\" -> 1, \"at005\" -> 0.124958499746, \"emax\" -> 1.2, \"atmax\" -> 0.102857388946|>, <|\"K\" -> 2, \"at005\" -> 0.249838887759, \"emax\" -> 0.999648661086, \"atmax\" -> 0.188624395888|>}|>;", "Input"],
Cell["(* page[...] holds the readouts the page computes in the browser; cmpGrid lays them beside the Wolfram values *)\ncmpRow[label_, q_, p_, w_] := {label, q, p, w, Abs[p - w]};\ncmpGrid[rows_] := valGrid[{\"\", \"quantity\", \"page (JavaScript)\", \"Wolfram\", \"|difference|\"}, rows];", "Input"],
Cell["PN 1. Surfaces", "Subsection"],
Cell["The page takes K and H by central finite differences with step 10\:207b\:00b3 on a 57 \:00d7 37 grid, and \:222cK dA by a 160 \:00d7 160 midpoint rule.", "Text"],
Cell["cmpGrid[Join @@ Table[{cmpRow[key, \"min K\", page[\"surfaces\", key, \"kmin\"], surfVals[key, \"kmin\"]], cmpRow[\"\", \"max K\", page[\"surfaces\", key, \"kmax\"], surfVals[key, \"kmax\"]],\n    cmpRow[\"\", \"max |H|\", page[\"surfaces\", key, \"hmax\"], surfVals[key, \"hmax\"]], cmpRow[\"\", \"\:222c K dA\", page[\"surfaces\", key, \"total\"], surfVals[key, \"total\"]]}, {key, Keys[surf]}]]", "Input"],
Cell["The finite differences agree with the exact values to about 5 \:00d7 10\:207b\:2077 (the O(h\:00b2) error of step 10\:207b\:00b3), except max |H| on the pseudosphere (3 \:00d7 10\:207b\:2074), which is reached at the edge of the patch where H grows fastest; the totals agree to the accuracy of the midpoint rule (2 \:00d7 10\:207b\:2074 at most, on the sphere).", "Text"],
Cell["PN 2. Ricci flow", "Subsection"],
Cell["The page runs the scheme of \:00a72 exactly, one explicit step per animation frame; the readings agree to round-off. The page\:2019s check line once quoted the write-up notebook \:00a710.2 (NDSolve on a 31 \:00d7 31 grid: max|K| 4.83 \:2192 0.059), a different bump and grid; it now quotes this run, 4.63 \:2192 0.059 by t = 2.00. On 23 Nov 2026 the page\:2019s colours were made to follow max|K| (with a fixed \:00b11.5 option), because on a fixed scale the end of the run looked blank.", "Text"],
Cell["cmpGrid[{cmpRow[\"bump 0.3\", \"max |K| at t = 0\", page[\"ricci\", \"maxK0\"], rr[\"maxK0\"]], cmpRow[\"\", \"t at the end\", page[\"ricci\", \"t\"], rr[\"t\"]],\n  cmpRow[\"\", \"max |K| at the end\", page[\"ricci\", \"maxK\"], rr[\"maxK\"]], cmpRow[\"\", \"\:222c K dA\", page[\"ricci\", \"totalK\"], rr[\"totalK\"]]}]", "Input"],
Cell["PN 3. Curved mean values", "Subsection"],
Cell["The page\:2019s circle mean is a 720-point rule in double precision, fitted on the same window. The last slope differs in the third decimal (8.005 on the page, 8.000 here) because those errors are near 10\:207b\:00b9\:00b3, where double precision shows; here the circle mean is computed to 25 digits.", "Text"],
Cell["cmpGrid[MapThread[cmpRow[#1, \"log\:2013log slope\", #2, #3] &, {{\"flat formula\", \"+ K\:0394f/96 at r^4\", \"+ r^6 terms\"}, page[\"means\", \"slopes\"], slopes}]]", "Input"],
Cell["PN 4. Heat trace", "Subsection"],
Cell["The page sums the sphere\:2019s eigenvalues and the torus\:2019s theta function in double precision, at the slider value (default t = 0.05).", "Text"],
Cell["cmpGrid[Join @@ Table[With[{t = h[\"t\"]}, {cmpRow[\"t = \" <> ToString[t], \"sphere t\:00b7Tr\", h[\"sphere\"], sph[t]],\n     cmpRow[\"\", \"1 + t/3 + t\:00b2/15\", h[\"series\"], 1 + t/3 + t^2/15], cmpRow[\"\", \"flat torus t\:00b7Tr\", h[\"torus\"], tor[t]]}], {h, page[\"heat\"]}]]", "Input"],
Cell["PN 5. Meshes", "Subsection"],
Cell["The page\:2019s mesh, barycentric area and corner angles are those of \:00a76, in JavaScript.", "Text"],
Cell["cmpGrid[Join @@ MapThread[{cmpRow[ToString[#2[\"nu\"]] <> \" \:00d7 \" <> ToString[#2[\"nv\"]], \"vertices\", #1[\"vertices\"], #2[\"vertices\"]], cmpRow[\"\", \"\:03a3 defect\", #1[\"defect\"], #2[\"defect\"]],\n     cmpRow[\"\", \"max |Kmesh \:2212 K|\", #1[\"err\"], #2[\"err\"]], cmpRow[\"\", \"Kmesh at the outer equator\", #1[\"Kouter\"], #2[\"Kouter\"]]} &, {page[\"mesh\"], meshVals}]]", "Input"],
Cell["PN 6. Graph curvatures", "Subsection"],
Cell[TextData[{"The page computes ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " and \:03ba\:2080 by its own transport solver, K_\:221e by bisection rounded down to 10\:207b\:2076 (hence differences below 10\:207b\:2076), and the rest by matrix pseudoinverses. Its notes under each graph were corrected on 23 Nov 2026 from \:00a77: the tree\:2019s two root edges are \:22121/3, not \:22122/3; on the grid only the corner edges (+1/3) and the edges from a side inward (+1/6) are positive, not the whole boundary; on the dumbbell the middle edge of the bridge is 0, not \:22123/5. The note that Steinerberger and resistance curvature are proportional on the tree was right (the factor is 15/7)."}], "Text"],
Cell["graphTable[g_] := Module[{sp = normSpec[graphOf[g]]},\n   Join[Join @@ Table[With[{w = N[wlValues[g, k]], p = page[\"graphs\", g, k]},\n       {{If[k == \"lly\", g, \"\"], curvs[k][[1]] <> \": min\", Min[p], Min[w], Abs[Min[p] - Min[w]]},\n        {\"\", \"   max\", Max[p], Max[w], Abs[Max[p] - Max[w]]},\n        {\"\", \"   largest |page \:2212 Wolfram| over all \" <> If[curvs[k][[2]] == \"e\", \"edges\", \"vertices\"], \"\", \"\", Max[Abs[p - w]]}}], {k, Keys[curvs]}],\n    {cmpRow[\"\", \"\:03bb\:2081 (normalised)\", page[\"graphs\", g, \"lambda1\"], sp[[2]]], cmpRow[\"\", \"\:03bbmax\", page[\"graphs\", g, \"lambdaMax\"], sp[[-1]]]}]];\n{page[\"graphs\", #, \"edges\"] == graphEdges[#] & /@ Keys[graphEdges], Column[{Style[#, Bold], cmpGrid[graphTable[#]]}, Spacings -> 1] & /@ Keys[graphEdges] // Column}", "Input"],
Cell["PN 7. Curve shortening", "Subsection"],
Cell["The page advances the flow of \:00a78 in animation frames of 3 \:00d7 10\:207b\:00b3 and stops at the end of the first frame below 8%, so its t is a little later than Wolfram\:2019s, which stops at the first step. Before 23 Nov 2026 the page used a fixed step 2 \:00d7 10\:207b\:2074: as the curve shrank its edges fell below the stability limit, the polygon broke into a zig-zag at the end, and the mean dA/dt read about \:22125.6 instead of \:22122\:03c0.", "Text"],
Cell["cmpGrid[Flatten[Table[{cmpRow[k, \"mean dA/dt\", page[\"flows\", k, \"rate\"], runs[k, \"rate\"]], cmpRow[\"\", \"t when area < 8%\", page[\"flows\", k, \"t\"], runs[k, \"t\"]]}, {k, Keys[runs]}], 1]]", "Input"],
Cell["PN 8. Ollivier on manifolds", "Subsection"],
Cell["The page integrates over the ball with a 160 \:00d7 160 midpoint rule (80 \:00d7 80 at the largest \:03b5). Its check line quotes \:03ba/\:03b5\:00b2 = 0.12496 (sphere), 0 (plane) and \:22120.12504 (hyperbolic plane) at \:03b5 = 0.05 from notebook 07-Ollivier \:00a78; the converged values of \:00a79 agree to five figures.", "Text"],
Cell["cmpGrid[Flatten[Table[{cmpRow[\"K = \" <> ToString[o[\"K\"]], \"\:03ba/\:03b5\:00b2 at \:03b5 = 0.05\", o[\"at005\"], \:03baball[o[\"K\"], 0.05]/0.05^2],\n     cmpRow[\"\", \"\:03ba/\:03b5\:00b2 at \:03b5 = \" <> ToString[NumberForm[o[\"emax\"], 3]], o[\"atmax\"], \:03baball[o[\"K\"], o[\"emax\"]]/o[\"emax\"]^2]}, {o, page[\"ollivier\"]}], 1]]", "Input"],
Cell["PN 9. The Lab\:2019s Wolfram cells", "Subsection"],
Cell["The snippets in \:00a7\:00a71\:201310 are the Lab\:2019s Wolfram cells exactly as the page offers them (lab/app.js, SNIP), with script letters written as named characters. On the page they run on the CCN Wolfram Cloud kernel after the reader enters a CCN-KEY.", "Text"],
Cell["\:00a9 2026 Computational Classnotes \:00b7 CC BY-NC-SA 4.0", "Text"]
},
WindowTitle -> "Laplacian Curvature Lab \:2014 the notebook behind the page",
StyleDefinitions -> "Default.nb"
]
