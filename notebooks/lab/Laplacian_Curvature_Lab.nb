3030303, -0.101515151515, -0.0760606060606, -0.101515151515, 0.0380303030303, 0.0627272727273, -0.0760606060606, -0.0490909090909, -0.0760606060606, 0.0627272727273, 0.0380303030303, -0.101515151515, -0.0760606060606, -0.101515151515, 0.0380303030303, 0.301060606061, 0.0380303030303, 0.0627272727273, 0.0380303030303, 0.301060606061}, \"stein\" -> {1, 0.375, 0.375, 0.375, 1, 0.375, -0.25, -0.25, -0.25, 0.375, 0.375, -0.25, -0.25, -0.25, 0.375, 0.375, -0.25, -0.25, -0.25, 0.375, 1, 0.375, 0.375, 0.375, 1}|>, \"dumbbell\" -> <|\"n\" -> 12, \"edges\" -> {{1, 2}, {8, 9}, {1, 3}, {8, 10}, {1, 4}, {8, 11}, {1, 5}, {8, 12}, {2, 3}, {9, 10}, {2, 4}, {9, 11}, {2, 5}, {9, 12}, {3, 4}, {10, 11}, {3, 5}, {10, 12}, {4, 5}, {11, 12}, {5, 6}, {6, 7}, {7, 8}}, \"lambda1\" -> 0.0286185595244, \"lambdaMax\" -> 1.68374064344, \"lly\" -> {1.25, 0.85, 1.25, 0.85, 1.25, 0.85, 0.85, 0.85, 1.25, 1.25, 1.25, 1.25, 0.85, 1.25, 1.25, 1.25, 0.85, 1.25, 0.85, 1.25, -0.6, 0, -0.6}, \"k0\" -> {0.75, 0.6, 0.75, 0.6, 0.75, 0.6, 0.6, 0.6, 0.75, 0.75, 0.75, 0.75, 0.6, 0.75, 0.75, 0.75, 0.6, 0.75, 0.6, 0.75, -0.6, 0, -0.6}, \"be\" -> {0.810496, 0.810496, 0.810496, 0.810496, -0.027695, -0.383096, -0.383096, -0.027695, 0.810496, 0.810496, 0.810496, 0.810496}, \"forman\" -> {-4, -5, -4, -5, -4, -5, -5, -5, -4, -4, -4, -4, -5, -4, -4, -4, -5, -4, -5, -4, -3, 0, -3}, \"formanAug\" -> {5, 4, 5, 4, 5, 4, 4, 4, 5, 5, 5, 5, 4, 5, 5, 5, 4, 5, 4, 5, -3, 0, -3}, \"res\" -> {0.2, 0.2, 0.2, 0.2, -0.3, -6.66133814775*^-16, -1.33226762955*^-15, -0.3, 0.2, 0.2, 0.2, 0.2}, \"stein\" -> {0.774193548387, 0.774193548387, 0.774193548387, 0.774193548387, -1.16129032258, 4.60742555219*^-15, -6.60582699652*^-15, -1.16129032258, 0.774193548387, 0.774193548387, 0.774193548387, 0.774193548387}|>|>, \"flows\" -> <|\"wiggle\" -> <|\"A0\" -> 3.39343363459, \"t\" -> 0.498, \"A\" -> 0.255225351169, \"rate\" -> -6.30162305908, \"vertices\" -> 36|>, \"star\" -> <|\"A0\" -> 3.45267940093, \"t\" -> 0.504, \"A\" -> 0.271862433851, \"rate\" -> -6.31114477595, \"vertices\" -> 31|>, \"bean\" -> <|\"A0\" -> 3.43379755367, \"t\" -> 0.504, \"A\" -> 0.260886381609, \"rate\" -> -6.29545867472, \"vertices\" -> 39|>, \"ellipse\" -> <|\"A0\" -> 3.14049769671, \"t\" -> 0.462, \"A\" -> 0.234885799578, \"rate\" -> -6.28920324055, \"vertices\" -> 47|>|>, \"ollivier\" -> {<|\"K\" -> -2, \"at005\" -> -0.250151370483, \"emax\" -> 0.999648661086, \"atmax\" -> -0.314776689329|>, <|\"K\" -> -1, \"at005\" -> -0.125036620424, \"emax\" -> 1.2, \"atmax\" -> -0.14806796806|>, <|\"K\" -> 0, \"at005\" -> 0, \"emax\" -> 1.2, \"atmax\" -> 0|>, <|\"K\" -> 1, \"at005\" -> 0.124958499746, \"emax\" -> 1.2, \"atmax\" -> 0.102857388946|>, <|\"K\" -> 2, \"at005\" -> 0.249838887759, \"emax\" -> 0.999648661086, \"atmax\" -> 0.188624395888|>}|>;", "Input"],
Cell["(* page[...] holds the readouts the page computes in the browser (lab/core.js), dumped by tools/lab_nb/js_readouts.js *)\ncmpRow[label_, q_, p_, w_] := {label, q, p, w, Abs[p - w]};\ncmpGrid[rows_] := Grid[Prepend[Map[If[NumericQ[#] && ! IntegerQ[#], NumberForm[N[#], 7], #] &, rows, {2}],\n   Style[#, Bold] & /@ {\"\", \"quantity\", \"page (JavaScript)\", \"Wolfram\", \"|difference|\"}],\n  Frame -> All, Alignment -> Left, Background -> {None, {1 -> GrayLevel[0.93]}}, FrameStyle -> GrayLevel[0.75]];", "Input"],
Cell["1. Gauss and mean curvature, coloured on six surfaces (page: #surfaces)", "Section"],
Cell["Page claims: K and H computed from the parametrisation; Gauss\:2013Bonnet \:222cK dA = 2\:03c0\:03c7, so 4\:03c0 on the sphere and 0 on the torus; on the torus K is positive outside, negative inside and zero on the top and bottom circles. The readouts are the range of K and the largest |H| over the drawn 57 \:00d7 37 grid, and \:222cK dA over the drawn parameter domain (the page uses finite differences with step 10\:207b\:00b3 and a 160 \:00d7 160 midpoint rule).", "Text"],
Cell["The page\:2019s Wolfram snippet (Gauss and mean curvature, and Gauss\:2013Bonnet on the torus):", "Text"],
Cell["(* Gauss and mean curvature of an embedded surface, and Gauss\:2013Bonnet on the torus *)\nsurfaceCurvatures[pos_, \\[ScriptX]_] := Module[{Xu, Xv, nn, E1, F1, G1, L1, M1, N1},\n  Xu = D[pos, \\[ScriptX][[1]]]; Xv = D[pos, \\[ScriptX][[2]]]; nn = Cross[Xu, Xv]/Sqrt[Cross[Xu, Xv] . Cross[Xu, Xv]];\n  {E1, F1, G1} = {Xu . Xu, Xu . Xv, Xv . Xv};\n  {L1, M1, N1} = {D[pos, \\[ScriptX][[1]], \\[ScriptX][[1]]] . nn, D[pos, \\[ScriptX][[1]], \\[ScriptX][[2]]] . nn, D[pos, \\[ScriptX][[2]], \\[ScriptX][[2]]] . nn};\n  <|\"K\" -> Simplify[(L1 N1 - M1^2)/(E1 G1 - F1^2)], \"H\" -> Simplify[(E1 N1 - 2 F1 M1 + G1 L1)/(2 (E1 G1 - F1^2))], \"dA\" -> Simplify[Sqrt[E1 G1 - F1^2]]|>];\ntorus = surfaceCurvatures[{(2 + Cos[v]) Cos[u], (2 + Cos[v]) Sin[u], Sin[v]}, {u, v}];\n{torus[\"K\"], Integrate[Simplify[torus[\"K\"] torus[\"dA\"], 0 < v < 2 \:03c0], {u, 0, 2 \:03c0}, {v, 0, 2 \:03c0}]}", "Input"],
Cell["Expected: K = cos v/(2 + cos v) and total 0.", "Text"],
Cell["Every surface the page offers, with its parameter domain, recomputed exactly (symbolic K and H, the same 57 \:00d7 37 grid, and NIntegrate for the total). The sphere is drawn for 0.02 \:2264 v \:2264 \:03c0 \:2212 0.02, so its exact total there is 4\:03c0 cos 0.02 = 12.5639, not 4\:03c0; the saddle, catenoid and pseudosphere are open patches, so their totals depend on the patch.", "Text"],
Cell["surf = <|\"sphere\" -> {{Sin[v] Cos[u], Sin[v] Sin[u], Cos[v]}, {0, 2 \:03c0}, {0.02, \:03c0 - 0.02}},\n   \"cylinder\" -> {{Cos[u], Sin[u], v}, {0, 2 \:03c0}, {-1, 1}},\n   \"torus\" -> {{(2 + Cos[v]) Cos[u], (2 + Cos[v]) Sin[u], Sin[v]}, {0, 2 \:03c0}, {0, 2 \:03c0}},\n   \"saddle\" -> {{u, v, u^2 - v^2}, {-1, 1}, {-1, 1}},\n   \"catenoid\" -> {{Cosh[v] Cos[u], Cosh[v] Sin[u], v}, {0, 2 \:03c0}, {-1.2, 1.2}},\n   \"pseudosphere\" -> {{Cos[u]/Cosh[v], Sin[u]/Cosh[v], v - Tanh[v]}, {0, 2 \:03c0}, {0.08, 3}}|>;\nsurfRows[key_] := Module[{X, U, V, c, g, Ks, Hs, tot},\n   {X, U, V} = surf[key]; c = surfaceCurvatures[X, {u, v}];\n   g = Flatten[Table[{U[[1]] + (U[[2]] - U[[1]]) i/56, V[[1]] + (V[[2]] - V[[1]]) j/36}, {i, 0, 56}, {j, 0, 36}], 1];\n   Ks = (c[\"K\"] /. {u -> #[[1]], v -> #[[2]]}) & /@ N[g]; Hs = (Abs[c[\"H\"]] /. {u -> #[[1]], v -> #[[2]]}) & /@ N[g];\n   tot = Chop[Quiet[NIntegrate[c[\"K\"] c[\"dA\"], {u, U[[1]], U[[2]]}, {v, V[[1]], V[[2]]}, PrecisionGoal -> 10, AccuracyGoal -> 12]], 10^-12];\n   {cmpRow[key, \"min K\", page[\"surfaces\", key, \"kmin\"], Min[Ks]], cmpRow[\"\", \"max K\", page[\"surfaces\", key, \"kmax\"], Max[Ks]],\n    cmpRow[\"\", \"max |H|\", page[\"surfaces\", key, \"hmax\"], Max[Hs]], cmpRow[\"\", \"\:222c K dA\", page[\"surfaces\", key, \"total\"], tot]}];\ncmpGrid[Join @@ (surfRows /@ Keys[surf])]", "Input"],
Cell["What to see: the page\:2019s finite differences agree with the exact values to about 5 \:00d7 10\:207b\:2077 (the O(h\:00b2) error of step h = 10\:207b\:00b3), and its totals to the accuracy of a 160 \:00d7 160 midpoint rule. The torus total is 0 and the sphere total 4\:03c0 cos 0.02, as Gauss\:2013Bonnet says for the drawn region.", "Text"],
Cell["torusK = Simplify[surfaceCurvatures[surf[\"torus\"][[1]], {u, v}][\"K\"]];\n{torusK, Reduce[torusK > 0 && 0 <= v < 2 \:03c0, v], Solve[torusK == 0 && 0 <= v < 2 \:03c0, v]}", "Input"],
Cell["K > 0 exactly on the outer half (cos v > 0) and K = 0 on the circles v = \:03c0/2 and 3\:03c0/2, the top and bottom of the tube, as the page says.", "Text"],
Cell["2. Ricci flow is a heat equation for the conformal factor (page: #ricci)", "Section"],
Cell["Page claims: with g = e^{2u}(dx\:00b2 + dy\:00b2), Ricci flow \:2202g/\:2202t = \:22122Ric is \:2202u/\:2202t = e^{\:22122u}\:0394\:2080u = \:2212K; on the flat torus a bumpy metric is ironed out and \:222cK dA stays exactly 0.", "Text"],
Cell["The page\:2019s snippet (Liouville form of K, and the shrinking sphere):", "Text"],
Cell["(* Liouville form of Gauss curvature, and the shrinking sphere under Ricci flow *)\nKconformal[w_] := Simplify[-Exp[-2 w] (D[w, {x, 2}] + D[w, {y, 2}])];\n{Kconformal[Log[2/(1 + x^2 + y^2)]], Kconformal[Log[1/y]], Simplify[D[(1 - 2 t) {{1, 0}, {0, Sin[\:03b8]^2}}, t] + 2 {{1, 0}, {0, Sin[\:03b8]^2}}]}", "Input"],
Cell[TextData[{"Expected: {1, \:22121, 0}: the stereographic sphere has K = 1, the half-plane K = \:22121, and (1 \:2212 2t)", Cell[BoxData[SubscriptBox["g", "S\:00b2"]]], " solves \:2202g/\:2202t = \:22122Ric = \:22122g."}], "Text"],
Cell["(* the conformal form: g = e^(2w) g0 and \:2202g/\:2202t = \:22122 K g give \:2202w/\:2202t = \:2212K = e^(\:22122w) \:03940 w *)\nSimplify[(D[Exp[2 w[x, y, t]], t] == -2 (-Exp[-2 w[x, y, t]] (D[w[x, y, t], {x, 2}] + D[w[x, y, t], {y, 2}])) Exp[2 w[x, y, t]]) /.\n   Derivative[0, 0, 1][w][x, y, t] -> Exp[-2 w[x, y, t]] (D[w[x, y, t], {x, 2}] + D[w[x, y, t], {y, 2}])]", "Input"],
Cell["The page\:2019s flow, reproduced step for step: a 32 \:00d7 32 periodic grid on [0, 2\:03c0)\:00b2, initial u = a cos x + b sin 2y cos(x + y) with the default bump a = 0.3, b = 0.83a, the five-point Laplacian, and explicit steps dt = 0.2 h\:00b2 e^{2 min u}, run until t \:2265 2.", "Text"],
Cell["ricciRun[a_, b_, N_] := Module[{h = 2. \:03c0/N, U, lap, Kf, t = 0., K0},\n   U = Table[a Cos[i h] + b Sin[2 j h] Cos[i h + j h], {i, 0, N - 1}, {j, 0, N - 1}];\n   lap[W_] := (RotateLeft[W, {1, 0}] + RotateRight[W, {1, 0}] + RotateLeft[W, {0, 1}] + RotateRight[W, {0, 1}] - 4 W)/h^2;\n   Kf[W_] := -Exp[-2 W] lap[W]; K0 = Max[Abs[Kf[U]]];\n   While[t < 2, Do[With[{dt = 0.2 h^2 Exp[2 Min[U]]}, U = U + dt Exp[-2 U] lap[U]; t += dt], {20}]];\n   <|\"maxK0\" -> K0, \"t\" -> t, \"maxK\" -> Max[Abs[Kf[U]]], \"totalK\" -> -Total[lap[U], 2] h^2|>];\nrr = ricciRun[0.3, 0.3 0.83, 32];\ncmpGrid[{cmpRow[\"bump 0.3\", \"max |K| at t = 0\", page[\"ricci\", \"maxK0\"], rr[\"maxK0\"]], cmpRow[\"\", \"t at the end\", page[\"ricci\", \"t\"], rr[\"t\"]],\n  cmpRow[\"\", \"max |K| at the end\", page[\"ricci\", \"maxK\"], rr[\"maxK\"]], cmpRow[\"\", \"\:222c K dA\", page[\"ricci\", \"totalK\"], rr[\"totalK\"]]}]", "Input"],
Cell["Note for the proof-reader. The page\:2019s check line used to quote the write-up notebook \:00a710.2 (NDSolve on a 31 \:00d7 31 grid: max|K| 4.83 \:2192 0.059 by t = 2). That is a different initial bump and grid, so it did not match the page\:2019s own readout (4.63 \:2192 0.053 by t \:2248 2.11 at the default bump). The page now quotes this section. \:222cK dA is 0 to round-off because it is \:2212h\:00b2\:03a3\:0394\:2080u, and a periodic Laplacian sums to zero exactly.", "Text"],
Cell["3. The mean-value origin of \:0394, on a curved surface (page: #means)", "Section"],
Cell[TextData[{"Page claims: on a surface of constant curvature K the geodesic-circle mean is ", Cell[BoxData[SubscriptBox["M", "r"]]], " f = f + r\:00b2\:0394f/4 + r\:2074(\:0394\:00b2f/64 + K\:0394f/96) + r\:2076(\:0394\:00b3f/2304 + K\:0394\:00b2f/1152 + K\:00b2\:0394f/1440) + O(r\:2078); for f = e\:02e3(1 + z)\:00b2 + yz\:00b3 on the unit sphere, at the pole f = 4, \:0394f = \:22124, \:0394\:00b2f = \:221220, \:0394\:00b3f = 500; the errors of the flat formula, of + K\:0394f/96, and of + the r\:2076 terms fall with slopes 4, 6 and 8 on log\:2013log axes; and A(r)/\:03c0r\:00b2 = 1 \:2212 Kr\:00b2/12 + K\:00b2r\:2074/360 \:2212 \:2026"}], "Text"],
Cell["The page\:2019s snippet: the pole values, and the r\:2076 expansion checked exactly (the last entry must be 0):", "Text"],
Cell["(* circle mean on S\:00b2 of f = e^x(1+z)^2 + y z^3, exact to r^6 *)\nF0[{x_, y_, z_}] := Exp[x] (1 + z)^2 + y z^3;\next = F0[{x, y, z}/Sqrt[x^2 + y^2 + z^2]];\n\:0394S2amb[h_] := Simplify[(x^2 + y^2 + z^2) Laplacian[h, {x, y, z}]];\nL1 = \:0394S2amb[ext]; L2 = \:0394S2amb[L1]; L3 = \:0394S2amb[L2]; atPole[h_] := h /. {x -> 0, y -> 0, z -> 1};\ncircleMean = Integrate[Normal@Series[F0[{Sin[r] Cos[\:03c6], Sin[r] Sin[\:03c6], Cos[r]}], {r, 0, 6}], {\:03c6, 0, 2 \:03c0}]/(2 \:03c0);\nformula = atPole[ext] + r^2/4 atPole[L1] + r^4 (atPole[L2]/64 + atPole[L1]/96) + r^6 (atPole[L3]/2304 + atPole[L2]/1152 + atPole[L1]/1440);\n{atPole /@ {ext, L1, L2, L3}, Simplify[Expand[circleMean - formula]]}", "Input"],
Cell["The error slopes, recomputed with the exact circle mean (NIntegrate at 30 digits) on the page\:2019s radii r = 2^{\:2212k/4}, k = 4 \:2026 24, fitted on 0.04 < r < 0.16 as the page does:", "Text"],
Cell["F0[{x_, y_, z_}] := Exp[x] (1 + z)^2 + y z^3; pole = {4, -4, -20, 500};\ncm[r_] := NIntegrate[F0[{Sin[r] Cos[\:03c6], Sin[r] Sin[\:03c6], Cos[r]}], {\:03c6, 0, 2 \:03c0}, WorkingPrecision -> 30, PrecisionGoal -> 25]/(2 \:03c0);\nflat[r_] := pole[[1]] + r^2/4 pole[[2]] + r^4 pole[[3]]/64; c4[r_] := flat[r] + r^4 pole[[2]]/96;\nc6[r_] := c4[r] + r^6 (pole[[4]]/2304 + pole[[3]]/1152 + pole[[2]]/1440);\nrs = Select[N[2^(-Range[4, 24]/4), 30], 0.04 < # < 0.16 &];\nslopes = Table[Coefficient[Fit[{Log[#], Log[Abs[cm[#] - ap[#]]]} & /@ rs, {1, s}, s], s], {ap, {flat, c4, c6}}];\ncmpGrid[MapThread[cmpRow[#1, \"log\:2013log slope\", #2, #3] &, {{\"flat formula\", \"+ K\:0394f/96 at r^4\", \"+ r^6 terms\"}, page[\"means\", \"slopes\"], slopes}]]", "Input"],
Cell["What to see: slopes near 4, 6 and 8. They are not exactly integers because each error still carries its next-order term on this window; the page fits the same window, so page and Wolfram agree closely. The last slope differs in the third decimal (8.005 on the page, 8.000 here) because those errors are near 10\:207b\:00b9\:00b3, where the page\:2019s double-precision 720-point circle mean starts to show round-off; here the circle mean is computed to 25 digits.", "Text"],
Cell["(* disc area on a surface of constant curvature K: A(r) = 2\:03c0(1 \:2212 cos \:221aK r)/K *)\nSeries[2 \:03c0 (1 - Cos[Sqrt[K] r])/K/(\:03c0 r^2), {r, 0, 5}]", "Input"],
Cell["4. Curvature is the first correction to Weyl\:2019s law (page: #heat)", "Section"],
Cell["Page claims: Tr e^{t\:0394} ~ (4\:03c0t)^{\:2212n/2}(Vol + (t/6)\:222bS + \:2026) (McKean\:2013Singer). For the unit sphere (eigenvalues l(l + 1), multiplicity 2l + 1, area 4\:03c0) the ratio to Weyl\:2019s Area/(4\:03c0t), which is t\:00b7Tr e^{t\:0394}, rises like 1 + t/3 (+ t\:00b2/15); the flat square torus of the same area stays at 1. The readouts are at the slider value, default t = 0.05.", "Text"],
Cell["The page\:2019s snippet:", "Text"],
Cell["(* heat trace of the unit sphere against 1 + t/3 + t^2/15 *)\nheatTrace[t_?NumericQ] := Sum[(2 j + 1) Exp[-j (j + 1) t], {j, 0, 2000}];\nTable[{t, t heatTrace[t], 1 + t/3 + t^2/15}, {t, {0.1, 0.03, 0.01}}]", "Input"],
Cell["sph[t_] := With[{s = SetPrecision[t, 30]}, s Sum[(2 l + 1) Exp[-l (l + 1) s], {l, 0, 600}]];  (* terms beyond l = 600 are below e^(\:22121800) for t \:2265 0.005 *)\ntor[t_] := t (EllipticTheta[3, 0, Exp[-\:03c0 t]])^2;  (* side 2\:221a\:03c0: eigenvalues \:03c0(m\:00b2 + n\:00b2) *)\ncmpGrid[Join @@ Table[With[{t = h[\"t\"]}, {cmpRow[\"t = \" <> ToString[t], \"sphere t\:00b7Tr\", h[\"sphere\"], sph[t]],\n     cmpRow[\"\", \"1 + t/3 + t\:00b2/15\", h[\"series\"], 1 + t/3 + t^2/15], cmpRow[\"\", \"flat torus t\:00b7Tr\", h[\"torus\"], tor[t]]}], {h, page[\"heat\"]}]]", "Input"],
Cell["(* why the torus line is flat: by Poisson summation \:03b83(0, e^(\:2212\:03c0t)) = t^(\:22121/2) \:03b83(0, e^(\:2212\:03c0/t)) *)\nTable[N[tor[t] - 1, 20], {t, {0.01, 0.05, 0.1, 0.4}}]", "Input"],
Cell["The torus ratio is \:03b8\:2083(0, e^{\:2212\:03c0/t})\:00b2 = 1 + 4e^{\:2212\:03c0/t} + \:2026: 1 to machine precision for t \:2264 0.1, and 1.0016 at the slider\:2019s end t = 0.4. \:201cStays at 1\:201d on the page means up to this exponentially small term; on the page\:2019s scale its curve is flat.", "Text"],
Cell["5. Bochner\:2019s formula, and what a curvature bound controls (page: #bochner)", "Section"],
Cell["Page claims: \:00bd\:0394|\:2207f|\:00b2 = |Hess f|\:00b2 + \:27e8\:2207f, \:2207\:0394f\:27e9 + Ric(\:2207f, \:2207f); integrated it gives Lichnerowicz \:03bb\:2081 \:2265 nk; along geodesics the comparison \:0394r \:2264 (n \:2212 1)\:221ak cot(\:221ak r); carr\:00e9 du champ \:0393(f) = \:00bd(\:0394(f\:00b2) \:2212 2f\:0394f) = |\:2207f|\:00b2 and \:0393\:2082(f) = \:00bd\:0394\:0393(f) \:2212 \:0393(f, \:0394f). The readouts at K (default 1, n = 2): Lichnerowicz bound 2K, round sphere \:03bb\:2081 = 2K, Bonnet\:2013Myers diameter \:2264 \:03c0/\:221aK, \:0394r changes sign at \:03c0/(2\:221aK); for K \:2264 0, \:0394r \:2192 \:221a|K|.", "Text"],
Cell["The page\:2019s snippet: Bochner on S\:00b2 for an arbitrary function (must return 0):", "Text"],
Cell["(* Bochner formula on S\:00b2 for an arbitrary function *)\nX = {\:03b8, \:03c6}; g = {{1, 0}, {0, Sin[\:03b8]^2}}; gi = Inverse[g];\n\:0393 = Table[1/2 Sum[gi[[i, l]] (D[g[[l, j]], X[[k]]] + D[g[[l, k]], X[[j]]] - D[g[[j, k]], X[[l]]]), {l, 2}], {i, 2}, {j, 2}, {k, 2}];\nLap[w_] := 1/Sqrt[Det[g]] Sum[D[Sqrt[Det[g]] gi[[i, j]] D[w, X[[j]]], X[[i]]], {i, 2}, {j, 2}];\ng2[w_] := Sum[gi[[i, j]] D[w, X[[i]]] D[w, X[[j]]], {i, 2}, {j, 2}];\nHs[w_] := Table[D[w, X[[i]], X[[j]]] - Sum[\:0393[[k, i, j]] D[w, X[[k]]], {k, 2}], {i, 2}, {j, 2}];\nf = \\[ScriptF][\:03b8, \:03c6];\nSimplify[1/2 Lap[g2[f]] - (Tr[gi . Hs[f] . gi . Hs[f]] + Sum[gi[[i, j]] D[f, X[[i]]] D[Lap[f], X[[j]]], {i, 2}, {j, 2}] + g2[f])]", "Input"],
Cell["(* on a surface of constant curvature K in geodesic polar coordinates, ds\:00b2 = dr\:00b2 + sn(r)\:00b2 d\:03b8\:00b2, \:0394r = sn'(r)/sn(r) *)\nsn[K_, r_] := Sin[Sqrt[K] r]/Sqrt[K];\n{Simplify[D[sn[K, r], r]/sn[K, r] - Sqrt[K] Cot[Sqrt[K] r], K > 0], Normal[Series[Sqrt[K] Cot[Sqrt[K] r], {K, 0, 0}]],\n Limit[Sqrt[-K] Coth[Sqrt[-K] r], r -> \:221e, Assumptions -> K < 0], Reduce[Sqrt[K] Cot[Sqrt[K] r] == 0 && 0 < r < \:03c0/Sqrt[K] && K > 0, r]}", "Input"],
Cell["(* round sphere of curvature K: \:03bb1 = 2K, the Lichnerowicz equality case for n = 2; \:0393 is |\:2207f|\:00b2 *)\nWith[{K = 7/3}, {Min[Select[Table[l (l + 1) K, {l, 0, 4}], # > 0 &]], 2 K}]", "Input"],
Cell["X = {\:03b8, \:03c6}; g = {{1, 0}, {0, Sin[\:03b8]^2}}; Lap[w_] := 1/Sin[\:03b8] (D[Sin[\:03b8] D[w, \:03b8], \:03b8] + D[w, \:03c6, \:03c6]/Sin[\:03b8]);\nSimplify[1/2 (Lap[\\[ScriptF][\:03b8, \:03c6]^2] - 2 \\[ScriptF][\:03b8, \:03c6] Lap[\\[ScriptF][\:03b8, \:03c6]]) - (D[\\[ScriptF][\:03b8, \:03c6], \:03b8]^2 + D[\\[ScriptF][\:03b8, \:03c6], \:03c6]^2/Sin[\:03b8]^2)]", "Input"],
Cell["6. On a mesh, angle defect is curvature and the cotangent Laplacian is \:22122Hn (page: #mesh)", "Section"],
Cell[TextData[{"Page claims: (\:0394f)_i = (1/2", Cell[BoxData[SubscriptBox["A", "i"]]], ") ", Cell[BoxData[SubscriptBox["\:03a3", "j"]]], " (cot ", Cell[BoxData[SubscriptBox["\:03b1", "ij"]]], " + cot ", Cell[BoxData[SubscriptBox["\:03b2", "ij"]]], ")(", Cell[BoxData[SubscriptBox["f", "j"]]], " \:2212 ", Cell[BoxData[SubscriptBox["f", "i"]]], "); the angle defect ", Cell[BoxData[SubscriptBox["\:03b4", "i"]]], " = 2\:03c0 \:2212 ", Cell[BoxData[SubscriptBox["\:03a3\:03b8", "i"]]], " (a cube corner: 2\:03c0 \:2212 3\:00b7\:03c0/2 = \:03c0/2); ", Cell[BoxData[SubscriptBox["K", "i"]]], " \:2248 ", Cell[BoxData[SubscriptBox["\:03b4", "i"]]], "/", Cell[BoxData[SubscriptBox["A", "i"]]], "; the defects of a closed mesh add to exactly 2\:03c0\:03c7. Fig. 7.1 on the page states: ang[i, j, k] := VectorAngle[P[[j]] \:2212 P[[i]], P[[k]] \:2212 P[[i]]] is the corner angle at vertex i; 1000 random triangles have angle sum \:03c0 (error below 10\:207b\:00b9\:2075); a right triangle gives \:03c0/2, \:03c0/4, \:03c0/4; a flat fan has defect 0, a square-pyramid apex 2\:03c0/3, a saddle vertex \:22120.81 (on z = (x\:00b2 \:2212 y\:00b2)/2, eight neighbours on the unit circle). The page\:2019s ", Cell[BoxData[SubscriptBox["A", "i"]]], " is the barycentric area (one third of each incident triangle)."}], "Text"],
Cell["6.1 The checks quoted in the caption of Fig. 7.1:", "Text"],
Cell["SeedRandom[7]; angSum[P_] := Module[{ang}, ang[i_, j_, k_] := VectorAngle[P[[j]] - P[[i]], P[[k]] - P[[i]]];\n   ang[1, 2, 3] + ang[2, 3, 1] + ang[3, 1, 2]];\n<|\"right triangle\" -> Module[{P = {{0, 0, 0}, {1, 0, 0}, {0, 1, 0}}, ang}, ang[i_, j_, k_] := VectorAngle[P[[j]] - P[[i]], P[[k]] - P[[i]]]; {ang[1, 2, 3], ang[2, 3, 1], ang[3, 1, 2]}],\n  \"max |angle sum \:2212 \:03c0|, 1000 random triangles\" -> Max[Table[Abs[angSum[RandomReal[{-1, 1}, {3, 3}]] - \:03c0], {1000}]],\n  \"symmetric in j, k\" -> Module[{P = RandomReal[1, {3, 3}]}, VectorAngle[P[[2]] - P[[1]], P[[3]] - P[[1]]] == VectorAngle[P[[3]] - P[[1]], P[[2]] - P[[1]]]]|>", "Input"],
Cell["defectAt[apex_, ring_] := 2 \:03c0 - Total[Table[VectorAngle[ring[[k]] - apex, ring[[Mod[k, Length[ring]] + 1]] - apex], {k, Length[ring]}]];\nhex = Table[{Cos[2 \:03c0 k/6], Sin[2 \:03c0 k/6], 0}, {k, 0, 5}];\n<|\"flat fan of six triangles\" -> Chop[defectAt[{0, 0, 0}, hex]],\n  \"square-pyramid apex (unit edges)\" -> FullSimplify[defectAt[{0, 0, 1/Sqrt[2]}, {{1, 0, 0}, {0, 1, 0}, {-1, 0, 0}, {0, -1, 0}}/Sqrt[2]]],\n  \"saddle vertex on z = (x\:00b2 \:2212 y\:00b2)/2, eight neighbours on the unit circle\" -> N[defectAt[{0, 0, 0}, Table[With[{t = 2 \:03c0 k/8}, {Cos[t], Sin[t], (Cos[t]^2 - Sin[t]^2)/2}], {k, 0, 7}]]]|>", "Input"],
Cell["The square-pyramid apex with unit edges has four equilateral corners, so its defect is 2\:03c0 \:2212 4\:03c0/3 = 2\:03c0/3. The saddle ring alternates up and down, so the corner angles add to more than 2\:03c0 and the defect is negative: \:22120.8054.", "Text"],
Cell["6.2 The regular polyhedra, quoted in the write-up \:00a76 and on the page\:2019s lede: every vertex defect, and their total divided by 2\:03c0, which is \:03c7 = 2.", "Text"],
Cell["polyDefects[name_] := Module[{P = N[PolyhedronData[name, \"VertexCoordinates\"]], F = PolyhedronData[name, \"FaceIndices\"], def},\n   def = ConstantArray[2. \:03c0, Length[P]];\n   Do[Do[With[{i = f[[k]], j = f[[Mod[k, Length[f]] + 1]], l = f[[Mod[k - 2, Length[f]] + 1]]}, def[[i]] -= VectorAngle[P[[j]] - P[[i]], P[[l]] - P[[i]]]], {k, Length[f]}], {f, F}];\n   {name, Length[P], Union[Rationalize[def/\:03c0, 10^-9]] \:03c0, Chop[Total[def]/(2 \:03c0), 10^-12]}];\nGrid[Prepend[polyDefects /@ {\"Tetrahedron\", \"Cube\", \"Octahedron\", \"Dodecahedron\", \"Icosahedron\"}, Style[#, Bold] & /@ {\"polyhedron\", \"vertices\", \"defect at each vertex\", \"\:03a3 defect / 2\:03c0\"}], Frame -> All]", "Input"],
Cell["6.3 The page\:2019s snippet (angle defect on a 40 \:00d7 20 torus mesh; must return 0):", "Text"],
Cell["(* angle defect on a torus mesh: total is exactly 0 = 2\:03c0\:03c7 *)\ntorusPos = {(2 + Cos[v]) Cos[u], (2 + Cos[v]) Sin[u], Sin[v]}; {nu, nv} = {40, 20};\nidx[i_, j_] := Mod[i, nu] nv + Mod[j, nv] + 1;\nP = Flatten[Table[N[torusPos /. {u -> 2 \:03c0 i/nu, v -> 2 \:03c0 j/nv}], {i, 0, nu - 1}, {j, 0, nv - 1}], 1];\nT = Flatten[Table[{{idx[i, j], idx[i + 1, j], idx[i + 1, j + 1]}, {idx[i, j], idx[i + 1, j + 1], idx[i, j + 1]}}, {i, 0, nu - 1}, {j, 0, nv - 1}], 2];\nang[i_, j_, k_] := VectorAngle[P[[j]] - P[[i]], P[[k]] - P[[i]]];\ndefect = ConstantArray[2. \:03c0, Length[P]];\nDo[{a, b, c} = tr; defect[[a]] -= ang[a, b, c]; defect[[b]] -= ang[b, c, a]; defect[[c]] -= ang[c, a, b], {tr, T}];\nChop[Total[defect], 10^-9]", "Input"],
Cell[TextData[{"6.4 The readouts at all four resolutions the page offers: vertices, \:03a3 defect, \:03a3 defect/2\:03c0 and max |", Cell[BoxData[SubscriptBox["K", "mesh"]]], " \:2212 K| with K = cos v/(2 + cos v). The mesh, the barycentric area and the cotangent weights below are the page\:2019s (lab/core.js), written in Wolfram Language."}], "Text"],
Cell["meshCurvature[P_, T_] := Module[{nv = Length[P], ang, def, Am},\n   ang[i_, j_, k_] := VectorAngle[P[[j]] - P[[i]], P[[k]] - P[[i]]];\n   def = ConstantArray[2. \:03c0, nv]; Am = ConstantArray[0., nv];\n   Do[Module[{a, b, c}, {a, b, c} = tri; def[[a]] -= ang[a, b, c]; def[[b]] -= ang[b, c, a]; def[[c]] -= ang[c, a, b];\n     Am[[{a, b, c}]] += Norm[Cross[P[[b]] - P[[a]], P[[c]] - P[[a]]]]/6], {tri, T}];\n   <|\"defect\" -> def, \"area\" -> Am|>];\ntorusMesh[nu_, nv_] := Module[{id}, id[i_, j_] := Mod[i, nu] nv + Mod[j, nv] + 1;\n   {Flatten[Table[N[{(2 + Cos[2 \:03c0 j/nv]) Cos[2 \:03c0 i/nu], (2 + Cos[2 \:03c0 j/nv]) Sin[2 \:03c0 i/nu], Sin[2 \:03c0 j/nv]}], {i, 0, nu - 1}, {j, 0, nv - 1}], 1],\n    Flatten[Table[{{id[i, j], id[i + 1, j], id[i + 1, j + 1]}, {id[i, j], id[i + 1, j + 1], id[i, j + 1]}}, {i, 0, nu - 1}, {j, 0, nv - 1}], 2]}];\nmeshRows[m_] := Module[{P, T, M, Km, Ks},\n   {P, T} = torusMesh[m[\"nu\"], m[\"nv\"]]; M = meshCurvature[P, T]; Km = M[\"defect\"]/M[\"area\"];\n   Ks = Flatten[Table[N[Cos[2 \:03c0 j/m[\"nv\"]]/(2 + Cos[2 \:03c0 j/m[\"nv\"]])], {i, 0, m[\"nu\"] - 1}, {j, 0, m[\"nv\"] - 1}]];\n   {cmpRow[ToString[m[\"nu\"]] <> \" \:00d7 \" <> ToString[m[\"nv\"]], \"vertices\", m[\"vertices\"], Length[P]],\n    cmpRow[\"\", \"\:03a3 defect\", m[\"defect\"], Total[M[\"defect\"]]], cmpRow[\"\", \"max |Kmesh \:2212 K|\", m[\"err\"], Max[Abs[Km - Ks]]],\n    cmpRow[\"\", \"Kmesh at the outer equator (K = 1/3)\", m[\"Kouter\"], Km[[1]]]}];\ncmpGrid[Join @@ (meshRows /@ page[\"mesh\"])]", "Input"],
Cell["What to see: the total defect is 0 = 2\:03c0\:03c7(torus) at every resolution, to round-off; the pointwise error falls by about 2.6 for each 1.6-fold refinement, i.e. like h\:00b2, as the barycentric-area estimate does on this regular mesh.", "Text"],
Cell["7. Seven graph curvatures, each built from the graph Laplacian (page: #graphs)", "Section"],
Cell[TextData[{"Page claims: the seven graphs (binary tree on 15 vertices, cycle C\:2086, cube Q\:2083, complete K\:2085, Petersen, 5 \:00d7 5 grid, dumbbell of two K\:2085 joined by a path of three edges) and seven curvatures: Lin\:2013Lu\:2013Yau ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " (edges), non-lazy Ollivier \:03ba\:2080 (edges), Bakry\:2013\:00c9mery K_\:221e (vertices), Forman F = 4 \:2212 ", Cell[BoxData[SubscriptBox["d", "x"]]], " \:2212 ", Cell[BoxData[SubscriptBox["d", "y"]]], " (edges), Forman with triangles F + 3\:00b7#triangles (edges), resistance curvature ", Cell[BoxData[SubscriptBox["p", "i"]]], " = 1 \:2212 \:00bd", Cell[BoxData[SubscriptBox["\:03a3", "j\:223ci"]]], " ", Cell[BoxData[SubscriptBox["\:03c9", "ij"]]], " (vertices) with \:03c9 the effective resistance, and Steinerberger curvature w solving Dw = n\:00b71 with D the distance matrix (vertices). The readouts are min, max and mean (the sum for resistance curvature) of the chosen curvature, \:03bb\:2081 and ", Cell[BoxData[SubscriptBox["\:03bb", "max"]]], " of the normalised Laplacian, and the checks \:03bb\:2081 \:2265 min ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " and \:03bb\:2081 \:2265 min K_\:221e. Vertex numbers below are the page\:2019s, plus one."}], "Text"],
Cell["The page\:2019s snippet (Lin\:2013Lu\:2013Yau by the M\:00fcnch\:2013Wojciechowski linear programme, and \:03bb\:2081 on Q\:2083):", "Text"],
Cell["(* Lin\:2013Lu\:2013Yau curvature (M\:00fcnch\:2013Wojciechowski LP) and the spectral gap *)\nnbr[G_, v_] := AdjacencyList[G, v]; \:0394g[G_, f_][v_] := Mean[f /@ nbr[G, v]] - f[v];\n\:03baLLY[G_, {x_, y_}] := Module[{S, vars, f, cons}, S = Union[{x, y}, nbr[G, x], nbr[G, y]];\n  vars = Table[Unique[\"f\"], {Length[S]}]; f = AssociationThread[S -> vars];\n  cons = Flatten[{f[y] - f[x] == 1, f[x] == 0, Table[With[{d = GraphDistance[G, S[[i]], S[[j]]]}, {f[S[[i]]] - f[S[[j]]] <= d, f[S[[j]]] - f[S[[i]]] <= d}], {i, Length[S]}, {j, i + 1, Length[S]}]}];\n  LinearOptimization[\:0394g[G, f][x] - \:0394g[G, f][y], cons, vars, \"PrimalMinimumValue\"]];\nG = HypercubeGraph[3]; A = N@AdjacencyMatrix[G]; d = Total[A];\n{Union[\:03baLLY[G, #] & /@ (List @@@ EdgeList[G])], Sort[Eigenvalues[IdentityMatrix[8] - DiagonalMatrix[d^(-1/2)] . A . DiagonalMatrix[d^(-1/2)]]][[2]]}", "Input"],
Cell[TextData[{"Expected: {{2/3}, 2/3}. All seven curvatures in Wolfram Language. ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " and \:03ba\:2080 are computed by optimal transport between the neighbourhood measures (LinearOptimization), K_\:221e as the largest K with \:0393\:2082 \:2212 K\:0393 \:2ab0 0 on functions on the ball of radius 2 (the quadratic forms are built symbolically from \:0394, then the bound is found by bisection on the least eigenvalue), resistance and Steinerberger curvature from pseudoinverses."}], "Text"],
Cell["W1[G_, m1_, m2_] := Module[{s1 = Keys[m1], s2 = Keys[m2], x, vars, d},\n   vars = Table[x[i, j], {i, Length[s1]}, {j, Length[s2]}];\n   d = Table[GraphDistance[G, a, b], {a, s1}, {b, s2}];\n   LinearOptimization[Total[d vars, 2], {Thread[Total[vars, {2}] == Values[m1]], Thread[Total[vars] == Values[m2]], Thread[Flatten[vars] >= 0]}, Flatten[vars], \"PrimalMinimumValue\"]];\n\:03bc[G_, v_, \:03b1_] := Merge[{<|v -> \:03b1|>, AssociationThread[AdjacencyList[G, v] -> (1 - \:03b1)/Length[AdjacencyList[G, v]]]}, Total];\n\:03ba\:03b1[G_, {x_, y_}, \:03b1_] := 1 - W1[G, \:03bc[G, x, \:03b1], \:03bc[G, y, \:03b1]];\n\:03baLLYedge[G_, e_] := 2 \:03ba\:03b1[G, e, 1/2];   (* Bourne et al.: \:03ba_LLY = 2 \:03ba_(1/2) *)\n\:03ba0edge[G_, e_] := \:03ba\:03b1[G, e, 0];\nformanE[G_, {x_, y_}] := 4 - VertexDegree[G, x] - VertexDegree[G, y];\nformanT[G_, {x_, y_}] := formanE[G, {x, y}] + 3 Length[Intersection[AdjacencyList[G, x], AdjacencyList[G, y]]];\nKBE[G_, x_] := Module[{B, n, e, f, lap, gam, q1, q2, M1, M2, lo = -10., hi = 10., mid},\n   B = Union[{x}, AdjacencyList[G, x], Flatten[AdjacencyList[G, #] & /@ AdjacencyList[G, x]]]; n = Length[B];\n   f = AssociationThread[B -> Array[e, n]];\n   lap[v_] := Mean[f /@ AdjacencyList[G, v]] - f[v];\n   gam[v_] := 1/2 Mean[(f[#] - f[v])^2 & /@ AdjacencyList[G, v]];\n   q1 = gam[x]; q2 = 1/2 (Mean[gam /@ AdjacencyList[G, x]] - gam[x]) - 1/2 Mean[(f[#] - f[x]) (lap[#] - lap[x]) & /@ AdjacencyList[G, x]];\n   M1 = D[q1, {Array[e, n], 2}]/2; M2 = D[q2, {Array[e, n], 2}]/2;\n   (* K\:221e(x) is the largest K with \:0393\:2082 \:2212 K\:0393 \:2ab0 0 on functions on the 2-ball: bisect on the least eigenvalue *)\n   Do[mid = (lo + hi)/2; If[Min[Eigenvalues[N[M2 - mid M1]]] >= -10^-10, lo = mid, hi = mid], {60}]; lo];\nresistanceP[G_] := Module[{L = N@KirchhoffMatrix[G], P}, P = PseudoInverse[L];\n   Table[1 - 1/2 Total[Function[j, P[[i, i]] + P[[j, j]] - 2 P[[i, j]]] /@ AdjacencyList[G, i]], {i, VertexCount[G]}]];\nsteinerbergerW[G_] := VertexCount[G] Total[PseudoInverse[N@GraphDistanceMatrix[G]], {2}];\nnormSpec[G_] := Module[{A = N@AdjacencyMatrix[G], d}, d = Total[A]; Sort[Eigenvalues[IdentityMatrix[Length[d]] - DiagonalMatrix[d^(-1/2)] . A . DiagonalMatrix[d^(-1/2)]]]];", "Input"],
Cell["\:0393 and \:0393\:2082 above are built straight from the definition \:0393(f) = \:00bd(\:0394(f\:00b2) \:2212 2f\:0394f), \:0393\:2082(f) = \:00bd\:0394\:0393(f) \:2212 \:0393(f, \:0394f) at x, as exact quadratic forms in the values of f on the 2-ball, not copied from the page\:2019s code; only the final bisection is the same idea as the page\:2019s.", "Text"],
Cell["curvs = <|\"lly\" -> {\"Lin\:2013Lu\:2013Yau \:03ba\", \"e\", \:03baLLYedge}, \"k0\" -> {\"Ollivier \:03ba\:2080\", \"e\", \:03ba0edge}, \"be\" -> {\"Bakry\:2013\:00c9mery K\:221e\", \"v\", KBE},\n   \"forman\" -> {\"Forman\", \"e\", formanE}, \"formanAug\" -> {\"Forman + triangles\", \"e\", formanT}, \"res\" -> {\"resistance p\", \"all\", resistanceP}, \"stein\" -> {\"Steinerberger\", \"all\", steinerbergerW}|>;\ngraphOf[g_] := Graph[Range[page[\"graphs\", g, \"n\"]], UndirectedEdge @@@ page[\"graphs\", g, \"edges\"]];\nwlValues[g_, k_] := With[{G = graphOf[g], c = curvs[k]}, Switch[c[[2]], \"e\", c[[3]][G, #] & /@ page[\"graphs\", g, \"edges\"], \"v\", c[[3]][G, #] & /@ VertexList[G], \"all\", c[[3]][G]]];\ngraphTable[g_] := Module[{G = graphOf[g], sp = normSpec[graphOf[g]]},\n   Join[Join @@ Table[With[{w = N[wlValues[g, k]], p = page[\"graphs\", g, k]},\n       {{If[k == \"lly\", g, \"\"], curvs[k][[1]] <> \": min\", Min[p], Min[w], Abs[Min[p] - Min[w]]},\n        {\"\", \"   max\", Max[p], Max[w], Abs[Max[p] - Max[w]]},\n        {\"\", \"   largest |page \:2212 Wolfram| over all \" <> If[curvs[k][[2]] == \"e\", \"edges\", \"vertices\"], \"\", \"\", Max[Abs[p - w]]}}], {k, Keys[curvs]}],\n    {cmpRow[\"\", \"\:03bb\:2081 (normalised)\", page[\"graphs\", g, \"lambda1\"], sp[[2]]], cmpRow[\"\", \"\:03bbmax\", page[\"graphs\", g, \"lambdaMax\"], sp[[-1]]]}]];\ncmpGrid[graphTable[\"dumbbell\"]]", "Input"],
Cell["The dumbbell is the page\:2019s default graph. The same table for the other six (each takes a few seconds; the linear programmes dominate):", "Text"],
Cell["Column[{Style[#, Bold], cmpGrid[graphTable[#]]}, Spacings -> 1] & /@ {\"tree\", \"cycle\", \"cube\", \"complete\", \"petersen\", \"grid\"} // Column", "Input"],
Cell["The note the page shows under each graph, checked claim by claim:", "Text"],
Cell["val[g_, k_] := N[wlValues[g, k]]; edgeIdx[g_, pred_] := Position[page[\"graphs\", g, \"edges\"], _?pred, {1}, Heads -> False][[All, 1]];\ntreeG = graphOf[\"tree\"]; leaves = Select[VertexList[treeG], VertexDegree[treeG, #] == 1 &];\n<|\"tree: interior edges \:03baLLY\" -> Union[Rationalize[val[\"tree\", \"lly\"][[edgeIdx[\"tree\", ! IntersectingQ[#, leaves] &]]], 10^-6]],\n  \"tree: leaf edges \:03baLLY\" -> Union[Rationalize[val[\"tree\", \"lly\"][[edgeIdx[\"tree\", IntersectingQ[#, leaves] &]]], 10^-6]],\n  \"tree: Steinerberger = c \:00d7 resistance, with c and the largest residual\" -> With[{w = val[\"tree\", \"stein\"], p = val[\"tree\", \"res\"]}, {w . p/p . p, Max[Abs[w - (w . p/p . p) p]]}],\n  \"tree: \:03baLLY on the two edges at the root (degree 2)\" -> Union[Rationalize[val[\"tree\", \"lly\"][[edgeIdx[\"tree\", MemberQ[#, 1] &]]], 10^-6]],\n  \"tree: resistance = distance\" -> (Chop[Table[With[{P = PseudoInverse[N@KirchhoffMatrix[treeG]]}, P[[i, i]] + P[[j, j]] - 2 P[[i, j]]], {i, 15}, {j, 15}] - GraphDistanceMatrix[treeG], 10^-6] == ConstantArray[0, {15, 15}]),\n  \"C6: \:03baLLY, \:03ba0, K\:221e\" -> (Union /@ Rationalize[{val[\"cycle\", \"lly\"], val[\"cycle\", \"k0\"], val[\"cycle\", \"be\"]}, 10^-6]),\n  \"Q3: \:03baLLY, K\:221e, \:03bb1\" -> {Union[Rationalize[val[\"cube\", \"lly\"], 10^-6]], Union[Rationalize[val[\"cube\", \"be\"], 10^-6]], Rationalize[normSpec[graphOf[\"cube\"]][[2]], 10^-6]},\n  \"K5: \:03baLLY, \:03bb1\" -> {Union[Rationalize[val[\"complete\", \"lly\"], 10^-6]], Rationalize[normSpec[graphOf[\"complete\"]][[2]], 10^-6]},\n  \"Petersen: \:03baLLY, \:03ba0, K\:221e, \:03bb1\" -> {Union[Rationalize[val[\"petersen\", \"lly\"], 10^-6]], Union[Rationalize[val[\"petersen\", \"k0\"], 10^-6]], Union[Rationalize[val[\"petersen\", \"be\"], 10^-6]], Rationalize[normSpec[graphOf[\"petersen\"]][[2]], 10^-6]},\n  \"grid: \:03baLLY by the degrees of the edge's ends (corner 2, side 3, interior 4)\" -> With[{deg = VertexDegree[graphOf[\"grid\"]]},\n     GroupBy[Transpose[{Sort[deg[[#]]] & /@ page[\"graphs\", \"grid\", \"edges\"], Rationalize[val[\"grid\", \"lly\"], 10^-6]}], First -> Last, Union]],\n  \"dumbbell: \:03baLLY on the three bridge edges\" -> Rationalize[val[\"dumbbell\", \"lly\"][[-3 ;;]], 10^-6]|>", "Input"],
Cell[TextData[{"Read against the page\:2019s notes, which were corrected on 23 Nov 2026 from this cell: on the tree the interior edges have ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " = \:22122/3 except the two edges at the root, whose end has degree 2 (\:22121/3), and the leaf edges have +2/3; on a tree effective resistance equals distance, and Steinerberger curvature is exactly 2n/(n \:2212 1) = 15/7 times resistance curvature (the page\:2019s note says \:201cproportional\:201d, which is right; the inverse distance matrix of a tree is \:2212\:00bdL + \:03c4\:03c4\:1d40/(2(n \:2212 1)) with \:03c4 = 2 \:2212 degree, Graham\:2013Lov\:00e1sz, so D\:207b\:00b91 = \:03c4/(n \:2212 1) and p = \:03c4/2); C\:2086 is flat for all three; Q\:2083 has ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " = K_\:221e = \:03bb\:2081 = 2/3 and K\:2085 has ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " = \:03bb\:2081 = 5/4, equality cases of \:03bb\:2081 \:2265 \:03ba; Petersen has ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " = 0, \:03ba\:2080 = \:22121/3, K_\:221e = \:22121/3 and \:03bb\:2081 = 2/3. On the grid ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " is 0 on interior edges and along the sides, +1/6 on edges from a side inward and +1/3 on edges at a corner (the page\:2019s note had said the whole boundary is positive). On the dumbbell the two edges joining a clique to the path have ", Cell[BoxData[SubscriptBox["\:03ba", "LLY"]]], " = \:22123/5 and the middle edge of the path has 0 (the note had said all bridge edges are \:22123/5)."}], "Text"],
Cell["(* the two discrete Lichnerowicz bounds the page ticks, on every graph *)\nTable[With[{G = graphOf[g]}, {g, normSpec[G][[2]] >= Min[val[g, \"lly\"]] - 10^-9, normSpec[G][[2]] >= Min[val[g, \"be\"]] - 10^-6, Chop[Total[val[g, \"res\"]] - 1, 10^-9] == 0}], {g, Keys[page[\"graphs\"]]}] //\n Grid[Prepend[#, Style[#, Bold] & /@ {\"graph\", \"\:03bb\:2081 \:2265 min \:03baLLY\", \"\:03bb\:2081 \:2265 min K\:221e\", \"\:03a3 p = 1 (Foster)\"}], Frame -> All] &", "Input"],
Cell["8. Mean-curvature flow: a curve rounds itself off (page: #flows)", "Section"],
Cell[TextData[{"Page claims: \:2202X/\:2202t = \:0394X = \:03baN; in the plane any embedded curve becomes convex, then round, and shrinks to a point (Gage\:2013Hamilton\:2013Grayson); the area falls at exactly 2\:03c0 per unit time because \:222e\:03ba ds = 2\:03c0. The page moves each vertex of a polygon by k(", Cell[BoxData[SubscriptBox["t", "f"]]], " \:2212 ", Cell[BoxData[SubscriptBox["t", "b"]]], ") with k = 2/(", Cell[BoxData[SubscriptBox["\:2113", "f"]]], " + ", Cell[BoxData[SubscriptBox["\:2113", "b"]]], ") (\:2113 the edge lengths, t the unit edge directions), the cycle-graph Laplacian weighted by arc length. Since 23 Nov 2026 its time steps are at most 0.2 \:00d7 (shortest edge)\:00b2, the stability limit of an explicit heat step; every 20 steps it checks the polygon and resamples it by arc length only when needed: when 160 \:00d7 (perimeter/initial perimeter) vertices (at least 24) is under 85% of the current count, or when the longest edge exceeds three times the shortest. Each resampling cuts corners and loses a little area, so it is done as rarely as this. Before this the step was a fixed 2 \:00d7 10\:207b\:2074; as the curve shrank its edges fell below that limit, the polygon broke into a zig-zag (\:201cprickly\:201d) at the end, and the mean dA/dt read about \:22125.6 instead of \:22122\:03c0."}], "Text"],
Cell["The page\:2019s snippet (exact flows: the round sphere under Ricci flow, and a sphere of radius \:221a(R\:2080\:00b2 \:2212 4t) under mean-curvature flow; both residuals 0):", "Text"],
Cell["(* exact flows: Ricci flow on the round sphere, mean-curvature flow of a sphere *)\n{Simplify[D[Sqrt[R0^2 - 4 t], t] + 2/Sqrt[R0^2 - 4 t]], Simplify[D[(1 - 2 t) {{1, 0}, {0, Sin[\:03b8]^2}}, t] + 2 {{1, 0}, {0, Sin[\:03b8]^2}}]}", "Input"],
Cell["The page\:2019s polygon flow in Wolfram Language, run on all four starting curves until the area falls below 8% of its start; the mean dA/dt should be \:22122\:03c0 = \:22126.2832:", "Text"],
Cell["curveInit[kind_, n_: 160] := Module[{f = <|\"wiggle\" -> (1 + 0.35 Cos[3 #] + 0.2 Sin[5 #] &), \"star\" -> (1 + 0.45 Cos[5 #] &),\n      \"ellipse\" -> (1/Sqrt[Cos[#]^2/1.6 + Sin[#]^2 1.6] &), \"bean\" -> (1 + 0.5 Cos[2 #] Sin[#] + 0.25 Cos[3 #] &)|>[kind]},\n   Table[With[{t = 2. \:03c0 k/n}, f[t] {Cos[t], Sin[t]}], {k, 0, n - 1}]];\ncurveStep[X_, dt_] := Module[{fw = RotateLeft[X] - X, bw = X - RotateRight[X], lf, lb},\n   lf = Norm /@ fw; lb = Norm /@ bw; X + dt (2/(lf + lb)) (fw/lf - bw/lb)];\nperimeter[X_] := Total[Norm /@ (RotateLeft[X] - X)];\npolyArea[X_] := Abs[Total[X[[All, 1]] RotateLeft[X][[All, 2]] - RotateLeft[X][[All, 1]] X[[All, 2]]]]/2;\nresample[X_, n_] := Module[{c = Append[X, First[X]], s, L, f}, s = Accumulate[Prepend[Norm /@ Differences[c], 0.]]; L = Last[s];\n   f = Interpolation[Transpose[{s, #}], InterpolationOrder -> 1] & /@ Transpose[c]; Table[Through[f[L i/n]], {i, 0, n - 1}]];\nflowRun[kind_] := Module[{X = curveInit[kind], A0, L0, t = 0., k = 0, h, dt},\n   A0 = polyArea[X]; L0 = perimeter[X];\n   While[polyArea[X] > 0.08 A0, h = Min[Norm /@ (RotateLeft[X] - X)]; dt = 0.2 h^2; X = curveStep[X, dt]; t += dt; k++;\n    If[Mod[k, 20] == 0, With[{e = Norm /@ (RotateLeft[X] - X), target = Max[24, Min[160, Round[160 perimeter[X]/L0]]]},\n      If[target < 0.85 Length[X] || Max[e] > 3 Min[e], X = resample[X, target]]]]];\n   <|\"t\" -> t, \"rate\" -> (polyArea[X] - A0)/t, \"vertices\" -> Length[X], \"X\" -> X|>];\nruns = AssociationMap[flowRun, {\"wiggle\", \"star\", \"bean\", \"ellipse\"}];\ncmpGrid[Flatten[Table[{cmpRow[k, \"mean dA/dt\", page[\"flows\", k, \"rate\"], runs[k, \"rate\"]], cmpRow[\"\", \"t when area < 8%\", page[\"flows\", k, \"t\"], runs[k, \"t\"]]}, {k, Keys[runs]}], 1]]", "Input"],
Cell[TextData[{"The page advances its flow in frames of 3 \:00d7 10\:207b\:00b3 (15 \:00d7 2 \:00d7 10\:207b\:2074) and stops at the end of the first frame below 8%, so its t is a little later than Wolfram\:2019s, which stops at the first step. Both rates are within about 0.5% of \:22122\:03c0; the small excess is the area lost at each resampling, and the polygon\:2019s own rate between resamplings is \:2212\:03a3 2 sin(", Cell[BoxData[SubscriptBox["\:03b8", "i"]]], "/2) over its turning angles ", Cell[BoxData[SubscriptBox["\:03b8", "i"]]], ", just under 2\:03c0. The last polygon of each run, which should be a smooth near-circle:"}], "Text"],
Cell["Row[Table[Graphics[{RGBColor[0.98, 0.56, 0.17], Thickness[0.012], Line[Append[#, First[#]] &[runs[k, \"X\"]]]}, PlotLabel -> k, ImageSize -> 140, PlotRange -> 0.45], {k, Keys[runs]}], \"  \"]", "Input"],
Cell[TextData[{StyleBox["Fig. 1. ", FontWeight -> "Bold", FontColor -> RGBColor[0.83, 0.34, 0.11]], "The last frame of curve shortening for the four starting curves: smooth near-circles, with no zig-zag."}], "Text"],
Cell["9. Comparing two ball averages measures Ricci curvature (page: #ollivier)", "Section"],
Cell[TextData[{"Page claims: Ollivier\:2019s \:03ba(x, y) = 1 \:2212 W\:2081(", Cell[BoxData[SubscriptBox["\:03bc", "x"]]], ", ", Cell[BoxData[SubscriptBox["\:03bc", "y"]]], ")/d(x, y) with \:03bc uniform on \:03b5-balls satisfies \:03ba \:2248 \:03b5\:00b2Ric(v, v)/(2(n + 2)) = \:03b5\:00b2K/8 on a surface; sliding the surface along the geodesic carries one ball onto the other, and a point at distance \:03bb from the geodesic moves \:03b4 cos(\:221aK \:03bb), so \:03ba is a plain integral over the ball. The readouts at K (slider \:22122 \:2026 2, default 1): \:03ba/\:03b5\:00b2 at \:03b5 = 0.05, K/8, and \:03ba/\:03b5\:00b2 at the largest \:03b5 drawn."}], "Text"],
Cell["The page\:2019s snippet:", "Text"],
Cell["(* Ollivier curvature of \:03b5-balls: \:03ba/\:03b5\:00b2 \:2192 K/8 on S\:00b2 and H\:00b2 *)\n\:03baS2[\:03b5_?NumericQ] := NIntegrate[With[{s = Sin[\:03c1] Sin[\:03b1]}, s^2/(1 + Sqrt[1 - s^2])] Sin[\:03c1], {\:03c1, 0, \:03b5}, {\:03b1, 0, 2 \:03c0}]/(2 \:03c0 (1 - Cos[\:03b5]));\n\:03baH2[\:03b5_?NumericQ] := -NIntegrate[With[{s = Sinh[\:03c1] Sin[\:03b1]}, s^2/(1 + Sqrt[1 + s^2])] Sinh[\:03c1], {\:03c1, 0, \:03b5}, {\:03b1, 0, 2 \:03c0}]/(2 \:03c0 (Cosh[\:03b5] - 1));\nTable[{\:03b5, \:03baS2[\:03b5]/\:03b5^2, \:03baH2[\:03b5]/\:03b5^2}, {\:03b5, {0.05, 0.2, 0.8}}]", "Input"],
Cell["\:03baball[K_, \:03b5_?NumericQ] := Which[K == 0, 0, K > 0, With[{R = 1/Sqrt[K]},\n     NIntegrate[With[{s = Sin[\:03c1/R] Sin[\:03b1]}, s^2/(1 + Sqrt[1 - s^2])] Sin[\:03c1/R], {\:03c1, 0, \:03b5}, {\:03b1, 0, 2 \:03c0}, PrecisionGoal -> 10]/NIntegrate[Sin[\:03c1/R] 2 \:03c0, {\:03c1, 0, \:03b5}]],\n   True, With[{R = 1/Sqrt[-K]}, -NIntegrate[With[{s = Sinh[\:03c1/R] Sin[\:03b1]}, s^2/(1 + Sqrt[1 + s^2])] Sinh[\:03c1/R], {\:03c1, 0, \:03b5}, {\:03b1, 0, 2 \:03c0}, PrecisionGoal -> 10]/NIntegrate[Sinh[\:03c1/R] 2 \:03c0, {\:03c1, 0, \:03b5}]]];\ncmpGrid[Flatten[Table[{cmpRow[\"K = \" <> ToString[o[\"K\"]], \"\:03ba/\:03b5\:00b2 at \:03b5 = 0.05\", o[\"at005\"], \:03baball[o[\"K\"], 0.05]/0.05^2], cmpRow[\"\", \"K/8\", o[\"K\"]/8, o[\"K\"]/8],\n     cmpRow[\"\", \"\:03ba/\:03b5\:00b2 at \:03b5 = \" <> ToString[NumberForm[o[\"emax\"], 3]], o[\"atmax\"], \:03baball[o[\"K\"], o[\"emax\"]]/o[\"emax\"]^2]}, {o, page[\"ollivier\"]}], 1]]", "Input"],
Cell["Note for the proof-reader. The page\:2019s check line quotes \:03ba/\:03b5\:00b2 = 0.12496 (sphere), 0 (plane) and \:22120.12504 (hyperbolic plane) at \:03b5 = 0.05 from notebook 07-Ollivier \:00a78. The page\:2019s own readout for K = \:22121 is \:22120.12504 (its 160 \:00d7 160 midpoint rule), and the converged value above agrees to five figures.", "Text"],
Cell["10. Every Laplacian\:2013curvature relationship on one sheet (page: #forms) and the free cell\:2019s other snippets", "Section"],
Cell["The sheet restates formulas checked in the sections above and in the write-up notebook (LaplacianCurvature.nb \:00a72\:2013\:00a710). Two snippets of the page\:2019s free Wolfram cell are not tied to a section above; both must return the stated value.", "Text"],
Cell["Yamabe: u\:2074 times the flat metric of \:211d\:00b3 is the round S\:00b3, scalar curvature 6:", "Text"],
Cell["(* Yamabe: u^4 times the flat metric of R^3 is the round S^3, scalar curvature 6 *)\nuY = (2/(1 + x^2 + y^2 + z^2))^(1/2); Simplify[-8 uY^-5 Laplacian[uY, {x, y, z}]]", "Input"],
Cell[TextData[{"Weitzenb\:00f6ck on S\:00b2: ", Cell[BoxData[SubscriptBox["\:0394", "Hodge"]]], " \:03c9 \:2212 \:2207*\:2207\:03c9 = Ric(\:03c9) = \:03c9 for every 1-form df + \:22c6dh (must return {0, 0}):"}], "Text"],
Cell["(* Weitzenb\:00f6ck on S\:00b2: Hodge Laplacian \:03c9 \:2212 \:2207*\:2207\:03c9 = Ric(\:03c9) = \:03c9 for every 1-form df + \:22c6dh *)\nX = {\:03b8, \:03c6}; g = {{1, 0}, {0, Sin[\:03b8]^2}}; gi = Inverse[g];\n\:0393 = Table[1/2 Sum[gi[[i, l]] (D[g[[l, j]], X[[k]]] + D[g[[l, k]], X[[j]]] - D[g[[j, k]], X[[l]]]), {l, 2}], {i, 2}, {j, 2}, {k, 2}];\nLap[w_] := 1/Sin[\:03b8] (D[Sin[\:03b8] D[w, \:03b8], \:03b8] + D[w, \:03c6, \:03c6]/Sin[\:03b8]);\nrough[\:03c9_] := Module[{T, TT}, T = Table[D[\:03c9[[i]], X[[j]]] - Sum[\:0393[[k, i, j]] \:03c9[[k]], {k, 2}], {i, 2}, {j, 2}];\n  TT = Table[D[T[[i, j]], X[[k]]] - Sum[\:0393[[m, k, i]] T[[m, j]] + \:0393[[m, k, j]] T[[i, m]], {m, 2}], {i, 2}, {j, 2}, {k, 2}];\n  Table[-Sum[gi[[j, k]] TT[[i, j, k]], {j, 2}, {k, 2}], {i, 2}]];\nd1[w_] := {D[w, \:03b8], D[w, \:03c6]}; star[{a_, b_}] := {-b/Sin[\:03b8], a Sin[\:03b8]};\n\:03c9 = d1[\\[ScriptF][\:03b8, \:03c6]] + star[d1[\\[ScriptH][\:03b8, \:03c6]]];\nSimplify[d1[-Lap[\\[ScriptF][\:03b8, \:03c6]]] + star[d1[-Lap[\\[ScriptH][\:03b8, \:03c6]]]] - (rough[\:03c9] + \:03c9)]", "Input"],
Cell["(* the ball-volume line of the sheet, n = 2 and n = 3 on spheres of curvature K: Vol B_r = \:03c9_n r^n (1 \:2212 S r\:00b2/(6(n + 2)) + \:2026), S = n(n \:2212 1)K *)\n{Series[2 \:03c0 (1 - Cos[Sqrt[K] r])/K/(\:03c0 r^2), {r, 0, 2}], Series[4 \:03c0/K^(3/2) (Sqrt[K] r/2 - Sin[2 Sqrt[K] r]/4)/(4/3 \:03c0 r^3), {r, 0, 2}], {1 - 2 K r^2/(6 4), 1 - 6 K r^2/(6 5)}}", "Input"],
Cell["11. Self-check: every answer the page marks right (page: #quiz)", "Section"],
Cell["tK = Simplify[(Cos[v]/(1 (2 + 1 Cos[v])))];\n<|\"1. torus K < 0 on the inner half\" -> Reduce[tK < 0 && 0 <= v < 2 \:03c0, v],\n  \"1. \:222cK dA on the torus\" -> Integrate[tK (2 + Cos[v]), {u, 0, 2 \:03c0}, {v, 0, 2 \:03c0}],\n  \"2. order at which K enters the circle mean (coefficient of K)\" -> (Coefficient[r^2/4 d1 + r^4 (d2/64 + K d1/96) + r^6 (d3/2304 + K d2/1152 + K^2 d1/1440), K] /. {d1 -> 1, d2 -> 1, d3 -> 1} // Expand),\n  \"3. heat trace t-term on the unit sphere: ratio \:2212 1 \:2248 t/3 = (1/6)\:222bS/Area\" -> {N[sph[0.001] - 1, 6], 0.001/3},\n  \"6. \:03a3 resistance curvature on every graph\" -> (Round[Total[val[#, \"res\"]], 10^-9] & /@ Keys[page[\"graphs\"]]),\n  \"7. dA/dt for the four curves\" -> (runs[#, \"rate\"] & /@ Keys[runs]),\n  \"8. \:2202u/\:2202t = \:2212K under 2-D Ricci flow\" -> \"\:00a72 above\"|>", "Input"],
Cell["Question 4 (Bakry\:2013\:00c9mery copies Bochner, \:0393\:2082 \:2265 K\:0393) and question 5 (the dumbbell\:2019s bridge is negative because its two neighbourhoods barely overlap) are checked in \:00a75 and \:00a77.", "Text"],
